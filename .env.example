# EASEHUB CAMPUS COMMERCE — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env or .env.local for local overrides.

# Application Environment
VITE_APP_NAME="EaseHub"
VITE_APP_ENV="development"
VITE_APP_URL="http://localhost:5173"

# Phase 8: Authentication Configuration (Future Backend Integration)
# Supported Providers: 'mock' | 'supabase' | 'firebase' | 'custom-api'
VITE_AUTH_PROVIDER="mock"

# Supabase Credentials (Optional for live persistence)
# VITE_SUPABASE_URL="https://xyzcompany.supabase.co"
# VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Campus Domain Verification Geofence
VITE_DEFAULT_CAMPUS="dtu-delhi"
VITE_ALLOW_GUEST_BOOKINGS="true"

# Service Request Repository Mode: 'session-storage' | 'rest-api'
VITE_STORAGE_ADAPTER="session-storage"
